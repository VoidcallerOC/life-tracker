# Copy to .env.local for development. Never commit real values.

# --- Required ---------------------------------------------------------------

# Shared password protecting every route.
AUTH_PASSWORD=change-me

# Postgres connection string. Works with Supabase, Neon, Vercel Postgres, or a
# local server. After setting it, run `npm run db:migrate`.
DATABASE_URL=postgres://user:password@host:5432/life_os

# --- Recommended ------------------------------------------------------------

# Signs session cookies. At least 16 characters of randomness
# (`openssl rand -hex 32`). Without it, sessions are signed with a key derived
# from AUTH_PASSWORD and every session dies when the password rotates.
SESSION_SECRET=

# --- Optional ---------------------------------------------------------------

# Key for /api/summary and /api/cron/notify, sent as the `x-admin-key` header.
# Falls back to AUTH_PASSWORD when unset.
ADMIN_API_KEY=

# Web push. Generate with `npm run push:keys`. Without these, notifications are
# simply unavailable and the rest of the app is unaffected.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Set automatically by Vercel Cron to authorize the scheduled notification run.
CRON_SECRET=

# Only needed once, to import the old Vercel Blob data (`npm run db:import`).
# BLOB_READ_WRITE_TOKEN=
