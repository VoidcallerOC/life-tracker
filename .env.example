# Copy to .env for local development. Do NOT commit a real production value.

# Shared password protecting every route.
AUTH_PASSWORD=change-me

# Production (Vercel Blob) for persistence. Leave unset locally to use the
# checked-in data/*.json seed files. Production requires a *_READ_WRITE_TOKEN;
# the app refuses to write to Vercel's read-only function filesystem.
# BLOB_READ_WRITE_TOKEN=
# BLOB_ACCESS_MODE=private
